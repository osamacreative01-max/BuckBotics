# Copy to .env.local and adjust. Both are optional —
# the form works with defaults (JSONL file store) if unset.

# Where submitted leads are appended (one JSON object per line).
# Default: .leads/enquiries.jsonl (created automatically, git-ignored)
# LEADS_FILE=.leads/enquiries.jsonl

# Optional CRM/automation webhook. When set, every lead is POSTed as JSON
# (Zapier, Make, HubSpot, or your own endpoint) in addition to the file store.
# CRM_WEBHOOK_URL=https://hooks.example.com/buckbotics-leads
